# Copy to .env.local for local dev. Never put real values in this file (see D-009).

# Local: file:./dev.db — Production: set via Fly.io secrets, see docs/decisions/D-006
DATABASE_URL="file:./dev.db"

# Shared app password checked at login (see docs/decisions/D-004)
APP_PASSWORD="changeme"

# Used to sign the session cookie (see docs/decisions/D-004)
SESSION_SECRET="changeme"

# Not used yet — only needed once Phase 7 (Fly.io deploy) is built, see D-006/D-009/D-012.
# Deploy-scoped GitHub Actions secret, never a full personal access token.
FLY_API_TOKEN=""
